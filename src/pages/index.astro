  "CS student at UT Austin with experience in systems programming, computer vision, and applied AI including C, Python, Java, JavaScript/TypeScript, REST APIs, and LLM-based tooling. Motivated by building things that solve real, practical problems";

const links = [
//Resume TO-DO
  { label: 'GitHub', href: 'https://github.com/tejas957' },
