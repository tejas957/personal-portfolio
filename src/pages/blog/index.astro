---
import Base from '../../layouts/Base.astro';
import { posts } from '../../data/posts.js';

const sorted = [...posts].sort((a, b) => new Date(b.date) - new Date(a.date));
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`; // ensures '/personal-portfolio/' not '/personal-portfolio'
---
<Base title="Blog">
  <div class="min-h-screen">
    <header class="border-b border-line">
      <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-5 font-mono text-sm">
        <a href={base} class="text-paper hover:text-amber transition-colors">~/portfolio</a>
        <div class="flex gap-6 text-muted">
          <a href={`${base}#projects`} class="hover:text-amber transition-colors">projects</a>
          <a href={`${base}blog`} class="text-amber">blog</a>
          <a href={`${base}#contact`} class="hover:text-amber transition-colors">contact</a>
        </div>
      </nav>
    </header>

    <section class="mx-auto max-w-4xl px-6 py-16">
      <h1 class="font-display text-3xl font-semibold">Blog</h1>
      <p class="mt-2 font-mono text-xs text-muted">tail -f writeups/*.html</p>

      {sorted.length === 0 && (
        <p class="mt-8 text-sm text-muted">No posts yet — add one in src/data/posts.js.</p>
      )}

      <ol class="mt-8 space-y-0">
        {sorted.map((p) => (
          <li class="relative border-l border-line pb-10 pl-8 last:pb-0">
            <span
              class="absolute -left-[7px] top-1.5 h-3 w-3 rounded-full border-2 border-teal bg-ink"
              aria-hidden="true"
            ></span>
            <p class="font-mono text-xs text-muted">{p.date}</p>
            <h2 class="mt-2 font-display text-xl font-semibold">
              <a href={`${base}blog/${p.slug}`} class="hover:text-amber transition-colors">{p.title}</a>
            </h2>
            <p class="mt-2 max-w-xl text-sm leading-relaxed text-paper/80">{p.summary}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {p.tags.map((t) => (
                <span class="rounded-full border border-line px-2.5 py-0.5 font-mono text-xs text-muted">{t}</span>
              ))}
            </div>
            <a href={`${base}blog/${p.slug}`} class="mt-4 inline-block font-mono text-xs text-amber hover:underline">read →</a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Base>
